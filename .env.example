# ==========================================
# User & Permission Configuration
# Run `id` on host to find your actual uid/gid
# ==========================================
PUID=1000
PGID=1000
TZ=America/New_York

# ==========================================
# Host Path Bindings
# ==========================================
# Fast SSD path for container config databases
CONFIG_DIR=/home/user/servarr/config

# Large storage drive for downloads and media libraries
MEDIA_DIR=/mnt/storage

# Host LAN IP (used for dashboard integrations)
SERVER_IP=192.168.1.100
HOST_IP=192.168.1.100

# ==========================================
# Servarr API Keys
# Retrieve from each service under Settings -> General
# ==========================================
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
LIDARR_API_KEY=your_lidarr_api_key_here
